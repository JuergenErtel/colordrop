<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-Level Privacy Manifest (Apple-Pflicht ab Frühjahr 2024).
  Das Google-Mobile-Ads-SDK liefert ein EIGENES Manifest mit für seine Domains;
  dieses hier deklariert die Nutzung der App selbst.

  ⚠️ MANUELLER XCODE-SCHRITT: Diese Datei muss dem App-Target hinzugefügt werden
     (Xcode → Datei in den "App"-Ordner ziehen → Target "App" anhaken, "Copy Bundle
     Resources"). Sonst landet sie nicht im Bundle.

  Tracking: NSPrivacyTracking=false auf APP-Ebene, weil der App-eigene Code NICHT
  trackt. Das Tracking (IDFA/Werbung) macht ausschließlich das Google-Mobile-Ads-
  SDK — dieses liefert sein EIGENES Privacy-Manifest mit NSPrivacyTracking=true +
  seinen Tracking-Domains mit, das Apple automatisch dazurechnet. Darum hier KEINE
  NSPrivacyTrackingDomains (true + leere Liste = Ablehnung ITMS-91064).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults (localStorage der WebView / Capacitor-Prefs). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
